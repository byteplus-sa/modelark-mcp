# ============================================================================
# ModelArk Seed Multimodal MCP Server — environment template
#
# Copy this file to .env and fill in credentials. Provider credentials are
# startup configuration only and never tool arguments. If a credential is
# absent, the server must not register that product's tool set.
#
# See plans/PLAN_MODELARK_SEED_MULTIMODAL_MCP.md (Configuration Contract).
# ============================================================================

# --- Provider credentials (required) ---------------------------------------
# ModelArk data-plane key for Seedream (image) and Seedance (video).
# Region-scoped: must match BYTEPLUS_MODELARK_BASE_URL.
BYTEPLUS_MODELARK_API_KEY=

# Seed Speech key for both Seed Audio (full-scene audio generation) and
# speech-to-text (ASR). Distinct from ModelArk; uses X-Api-Key, not Bearer.
BYTEPLUS_SEED_SPEECH_API_KEY=

# BytePlus VOD AI MediaKit Bearer key for asynchronous video enhancement submission.
# Keep this secret out of tool arguments, logs, and committed configuration.
BYTEPLUS_VOD_MEDIAKIT_API_KEY=

# BytePlus VOD OpenAPI signature credentials for voice and background audio
# separation (StartExecution/GetExecution). Both AK and SK must be set to
# register the audio separation tools. Keep the SK out of logs and git.
BYTEPLUS_VOD_ACCESS_KEY_ID=
BYTEPLUS_VOD_SECRET_ACCESS_KEY=

# --- Provider base URLs ----------------------------------------------------
# ModelArk data-plane host. Default: ap-southeast region.
BYTEPLUS_MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Seed Speech host. Default: ap-southeast-1 region.
BYTEPLUS_SEED_AUDIO_BASE_URL=https://voice.ap-southeast-1.bytepluses.com

# VOD AI MediaKit convenience API base URL. Must use HTTPS.
BYTEPLUS_VOD_MEDIAKIT_BASE_URL=https://mediakit.ap-southeast-1.bytepluses.com/api/v1

# BytePlus VOD OpenAPI endpoint. Must use HTTPS.
BYTEPLUS_VOD_BASE_URL=https://vod.byteplusapi.com
# VOD OpenAPI signing region. Default: ap-southeast-1.
BYTEPLUS_VOD_REGION=ap-southeast-1
# Optional bare playback domain used to build output audio URLs
# (e.g. "play.example.com"). No scheme, port, or path.
BYTEPLUS_VOD_PLAYBACK_DOMAIN=

# --- Model bindings --------------------------------------------------------
# Bind logical families to account-authorized model/endpoint IDs.
# These are configuration, not hard-coded truth.
SEEDREAM_DEFAULT_MODEL=dola-seedream-5-0-pro-260628
SEEDANCE_DEFAULT_MODEL=dreamina-seedance-2-0-260128
# Seed 2.1 multimodal understanding (video/image understanding, reasoning).
# Reuses BYTEPLUS_MODELARK_API_KEY — no separate credential needed.
SEED_UNDERSTANDING_DEFAULT_MODEL=dola-seed-2-1-turbo-260628
# The built-in default IDs have known families. Any custom default ID must set
# a family or provide the JSON binding list below; names are never inferred.
# seedream: pro | lite | 4x
# seedance: standard | fast | mini | seedance_2_5
# seed-understanding: pro | turbo
SEEDREAM_MODEL_FAMILY=
SEEDANCE_MODEL_FAMILY=
SEED_UNDERSTANDING_MODEL_FAMILY=
# JSON arrays for multiple explicitly authorized models, for example:
# SEEDREAM_MODEL_BINDINGS=[{"model_id":"my-image-endpoint","family":"pro"}]
# SEEDANCE_MODEL_BINDINGS=[{"model_id":"my-video-endpoint","family":"standard"}]
# To enable Seedance 2.5, include a 2.5 binding:
# SEEDANCE_MODEL_BINDINGS=[{"model_id":"dreamina-seedance-2-0-260128","family":"standard"},{"model_id":"dreamina-seedance-2-5-260628","family":"seedance_2_5"}]
# SEED_UNDERSTANDING_MODEL_BINDINGS=[{"model_id":"my-model","family":"turbo"}]
SEEDREAM_MODEL_BINDINGS=
SEEDANCE_MODEL_BINDINGS=
SEED_UNDERSTANDING_MODEL_BINDINGS=

# --- Seed Speech ASR (STT) configuration -----------------------------------
# Speech-to-text reuses BYTEPLUS_SEED_SPEECH_API_KEY — no separate key needed.
# HTTP base URL for Seed Speech ASR submit + query.
SEED_SPEECH_ASR_BASE_URL=https://voice.ap-southeast-1.bytepluses.com
# Seconds between ASR query polls. Default: 3.0.
SEED_SPEECH_ASR_POLL_INTERVAL_SECONDS=3.0
# Maximum total seconds to wait for ASR result. Default: 600.
SEED_SPEECH_ASR_POLL_MAX_SECONDS=600.0

# --- MCP transport ---------------------------------------------------------
# stdio (default, local) or http (Streamable HTTP, remote deployment).
MCP_TRANSPORT=stdio
# Bind address for HTTP transport. 127.0.0.1 by default to prevent DNS rebinding.
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Comma-separated allowed Origin values for HTTP transport. Empty = localhost only.
MCP_ALLOWED_ORIGINS=
# Comma-separated Host header values. Include the public hostname for remote use.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# When true, /ready also checks provider connectivity. Default: false.
READINESS_CHECK_PROVIDERS=false
# Per-provider timeout for readiness checks. Default: 2.0 seconds.
READINESS_PROVIDER_TIMEOUT_SECONDS=2.0
# Maximum HTTP requests per minute per client IP. 0 disables rate limiting.
RATE_LIMIT_RPM=0
# Maximum burst size for the token bucket. 0 defaults to RATE_LIMIT_RPM.
RATE_LIMIT_BURST=0

# local is accepted only for stdio or loopback HTTP. Network HTTP must use jwt.
MCP_AUTH_MODE=local
# Required together when MCP_AUTH_MODE=jwt.
MCP_JWT_JWKS_URI=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
MCP_TENANT_CLAIM=tenant_id

# --- TOS object storage (optional) -----------------------------------------
# Enables the `media_upload` and `media_presign` tools, which upload media to
# a private TOS bucket and return presigned HTTPS GET URLs. Required for Seedance video
# references, which accept a URL only (no inline Base64).
# AK and SK must both be set or both be empty. Keep the bucket private;
# presigned URLs grant temporary read access to individual objects.
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
# Optional temporary security token (STS credentials only).
TOS_SECURITY_TOKEN=
# Target bucket name. The tool registers only when AK + SK + bucket are set.
TOS_BUCKET=
# Region and endpoint must match where the bucket was created.
# Endpoint format: tos-<region>.bytepluses.com
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com
# Presigned URL validity in seconds. Range: 60–604800. Default: 30 minutes.
TOS_PRESIGN_TTL_SECONDS=1800

# --- S3 object storage (optional) ------------------------------------------
# Alternative to TOS. Set OBJECT_STORAGE_BACKEND=s3 to use S3 instead of TOS
# for the `media_upload` and `media_presign` tools. Supports native AWS S3 and S3-compatible
# storage (MinIO, R2, TOS-via-boto3) via S3_ENDPOINT.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Target bucket name. The tool registers only when AK + SK + bucket are set.
S3_BUCKET=
# AWS region. Default: us-east-1.
S3_REGION=us-east-1
# Empty = native AWS endpoint resolved from region. Set for S3-compatible
# storage (e.g. "https://tos-<region>.bytepluses.com", MinIO endpoint).
S3_ENDPOINT=
# Presigned URL validity in seconds. Range: 60–604800. Default: 30 minutes.
S3_PRESIGN_TTL_SECONDS=1800
# Select the active object-storage backend: tos (default) or s3.
OBJECT_STORAGE_BACKEND=tos

# --- Artifact persistence --------------------------------------------------
# Filesystem is the currently implemented backend. Use a shared filesystem or
# implement a distributed backend before running multiple replicas.
ARTIFACT_BACKEND=filesystem
ARTIFACT_DIR=.artifacts
# Artifact retention TTL in seconds. Default: 7 days (604800).
ARTIFACT_TTL_SECONDS=604800
# Inline media cap for MCP image/audio content blocks. Default: 8 MiB.
MCP_INLINE_MEDIA_MAX_BYTES=8388608
# Maximum inbound Streamable HTTP request body. Default: 10 MiB.
MCP_HTTP_MAX_BODY_BYTES=10485760

# --- HTTP timeouts (milliseconds) ------------------------------------------
BYTEPLUS_CONNECT_TIMEOUT_MS=10000
# 10-minute request timeout covers long synchronous Seedream Pro generations
# (60–150s typical, longer under cold start or provider queue).
BYTEPLUS_REQUEST_TIMEOUT_MS=600000

# --- Runtime policy --------------------------------------------------------
PROVIDER_MAX_CONCURRENCY=5
PRINCIPAL_MAX_CONCURRENCY=3
# Per-principal UTC daily estimate limit in USD. 0 records without blocking.
DAILY_BUDGET_USD=0
# Maximum number of provider task IDs cached in the artifact-resolution cache.
PERSISTENCE_CACHE_MAX_SIZE=10000
# TTL in seconds for cached task-to-artifact mappings. Default: 24 hours.
PERSISTENCE_CACHE_TTL_SECONDS=86400

# --- Logging ---------------------------------------------------------------
# Minimum log level for structured stderr logs: DEBUG | INFO | WARNING | ERROR
MODELARK_LOG_LEVEL=INFO
